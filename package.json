    "lucide-react": "^0.554.0",
    "madge": "^8.0.0",
    "mermaid": "^11.12.1",
    "motion": "^12.23.24",
    "next": "^16.3.4",
    "next-auth": "^5.0.0-beta.30",
    "next-pwa": "^5.6.0",
    "next-themes": "^0.4.6",
